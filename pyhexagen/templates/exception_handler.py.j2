from fastapi import Request, status
from fastapi.responses import JSONResponse
from src.domain.exceptions import DomainException, EntityNotFoundException

def add_exception_handlers(app):
    @app.exception_handler(EntityNotFoundException)
    async def entity_not_found_exception_handler(request: Request, exc: EntityNotFoundException):
        return JSONResponse(
            status_code=status.HTTP_404_NOT_FOUND,
            content={"error": "Not Found", "message": exc.message},
        )

    @app.exception_handler(DomainException)
    async def domain_exception_handler(request: Request, exc: DomainException):
        return JSONResponse(
            status_code=status.HTTP_400_BAD_REQUEST,
            content={"error": "Domain Error", "message": exc.message},
        )
